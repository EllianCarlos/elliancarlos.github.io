---
layout: layouts/layout.njk
title: 404
seoTitle: Page Not Found
description: The page you're looking for doesn't exist.
type: error
eleventyExcludeFromCollections: true
permalink: /404.html
---
{% import "tty/core.njk" as tty %}
<div class="tty-screen">
  {#
    id="error-404" is not decorative — it is the sole guard in
    languageRedirect.njk against a redirect loop on an untranslated
    language-prefixed 404 (e.g. /pt/pt/pt/...). Do not remove it.
  #}
  <section id="error-404">
    <p class="tty-eyebrow">status 404</p>
    <h1 class="tty-h1" style="margin-top: 18px">{{ i18n.en.error.title }}</h1>
    <p class="tty-prose tty-prose--md" style="margin-top: 18px">{{ i18n.en.error.message }}</p>
    <div style="margin-top: 26px">
      <a class="tty-btn tty-btn--primary" href="/">{{ i18n.en.error.home }}</a>
    </div>
  </section>
</div>

<script>
  // A language-prefixed URL that was never translated (e.g. /pt/posts/xxx) bounces
  // to the English path instead of showing a 404. This is the only script this page
  // needs; the language selector it used to update no longer exists.
  (function() {
    const path = window.location.pathname;
    const langPrefix = path.match(/^\/(pt|es|ja)\/(.*)$/);
    if (langPrefix) {
      const strippedPath = '/' + langPrefix[2];
      if (strippedPath !== path) {
        window.location.replace(strippedPath);
      }
    }
  })();
</script>
