---
layout: layouts/layout.njk
type: blog
pagination:
  data: collections.tagPages
  size: 1
  alias: tagPage
---
{% import "tty/core.njk" as tty %}
{% import "tty/content.njk" as ttyc %}
{#
  One page per (language, tag) pair. `tagPage`, `permalink` and `locale` are
  computed in src/tag/tag.11tydata.js — do not set them here.

  The head and the row list are the same two blocks /posts/ uses, so a tag page
  reads as a filtered view of it. The button goes back to the full list.
#}
{%- set posts = collections['posts_' + tagPage.lang] | filterByTag(tagPage.tag) -%}
{%- set idx = posts | postIndexes -%}
<div class="tty-list">
  <div class="tty-list__head">
    <h1 class="tty-h1">{{ i18n[locale].blog.postsTagged }} {{ tagPage.tag }}</h1>
    <span class="tty-list__count">{{ posts.length | plural(i18n[locale].blog.post, i18n[locale].blog.count) }}</span>
    <span class="tty-spacer"></span>
    <a class="tty-btn tty-btn--sm" href="{{ '/posts' | i18nUrl(locale) }}/">{{ i18n[locale].nav.posts }}</a>
  </div>

  {% if posts.length == 0 %}
  <p class="tty-search__empty">{{ i18n[locale].blog.noPostsWithTag }}</p>
  {% else %}
  <div class="tty-list__rows">
    {%- for post in posts -%}
      {{ ttyc.postrow(post, idx[post.url]) }}
    {%- endfor -%}
  </div>
  {% endif %}
</div>
