{#
  All string values go through `| dump` so quotes, backslashes and newlines in
  titles or descriptions can't produce invalid JSON-LD. `dump` emits the
  surrounding quotes itself, so these are deliberately not wrapped in "".
#}
{% set sameAs = [
  seo.social.github,
  seo.social.linkedin,
  seo.social.lattes,
  seo.social.orcid,
  seo.social.scholar,
  seo.social.wikidata
] | select() | list %}

{% if page.url == '/' or page.url == '/index.html' %}
<!-- Person Schema for Homepage -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": {{ seo.author.id | dump | safe }},
  "name": {{ seo.author.name | dump | safe }},
  "url": {{ seo.author.url | dump | safe }},
  "jobTitle": {{ seo.author.jobTitle | dump | safe }},
  "worksFor": {
    "@type": "Organization",
    "name": {{ seo.author.worksFor | dump | safe }}
  },
  "affiliation": {
    "@type": "CollegeOrUniversity",
    "name": {{ seo.author.affiliation | dump | safe }}
  },
  "knowsAbout": {{ seo.author.knowsAbout | dump | safe }},
  "sameAs": {{ sameAs | dump | safe }}
  {#
    knowsLanguage was hard-coded as ["en", "pt", "es", "ja"] — the i18n plan's four
    languages. It outlived the plan: the site has built English-only since the
    Cleanup commit, so the claim was advertising three languages a reader could not
    find a single page in.

    It is derived and gated now, not deleted outright, so it cannot go stale a second
    time. `languages` comes from .eleventy.js and is `["en"]` while I18N_ENABLED is
    false, which is why the gate is on i18nEnabled rather than on the list: one
    language is not a multilingual claim worth making, and flipping the flag back on
    restores the tag with whatever languages actually exist.

    Note for whoever revisits this: schema.org knowsLanguage describes the PERSON,
    not the site's translations. A deliberate claim about languages the author speaks
    would be legitimate even with i18n off — it would just belong in seo.js as data,
    beside knowsAbout, rather than being inferred from the build.
  #}
  {%- if i18nEnabled and languages.length > 1 %},
  "knowsLanguage": {{ languages | dump | safe }}
  {%- endif %}
}
</script>
{% endif %}

{% if type == "blog" %}
<!-- Blog Schema for Blog Index -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": {{ (seo.siteName + " Blog") | dump | safe }},
  "description": {{ i18n[locale].seo.blog.description | dump | safe }},
  "url": {{ (seo.baseUrl + page.url) | dump | safe }},
  "author": { "@id": {{ seo.author.id | dump | safe }} }
}
</script>
{% endif %}

{% if type == "blogPost" %}
<!-- BlogPosting Schema for Blog Posts -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | dump | safe }},
  "description": {{ (description or (content | striptags | truncate(160))) | dump | safe }},
  "author": { "@id": {{ seo.author.id | dump | safe }} },
  "datePublished": {{ date.toISOString() | dump | safe }},
  {% if modified %}"dateModified": {{ modified.toISOString() | dump | safe }},{% endif %}
  {% if tags and tags.length %}"keywords": {{ tags | dump | safe }},{% endif %}
  "url": {{ (seo.baseUrl + page.url) | dump | safe }},
  "image": {{ (ogImage or seo.defaultImage) | dump | safe }},
  "inLanguage": {{ (locale or "en") | dump | safe }},
  "publisher": { "@id": {{ seo.author.id | dump | safe }} },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": {{ (seo.baseUrl + page.url) | dump | safe }}
  }
}
</script>
{% endif %}

{#
  The Person node is only emitted on the homepage, so every other page needs a
  minimal stub for its "@id" references to resolve when a crawler fetches that
  page in isolation.
#}
{% if page.url != '/' and page.url != '/index.html' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": {{ seo.author.id | dump | safe }},
  "name": {{ seo.author.name | dump | safe }},
  "url": {{ seo.author.url | dump | safe }},
  "sameAs": {{ sameAs | dump | safe }}
}
</script>
{% endif %}
