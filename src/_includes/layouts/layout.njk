---
type: index
---
<!DOCTYPE html>
<html lang="{{ locale or 'en' }}">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#0A0A09">

  <!-- SEO Meta Tags -->
  {% set pageTitle = seoTitle or title or i18n[locale].seo.defaultTitle %}
  {% if pageTitle != seo.siteName %}
    <title>{{ pageTitle }} | {{ seo.siteName }}</title>
  {% else %}
    <title>{{ seo.siteName }}</title>
  {% endif %}

  <meta name="description" content="{{ description or i18n[locale].seo.defaultDescription }}">
  <meta name="author" content="{{ seo.author.name }}">

  <!-- Canonical URL -->
  <link rel="canonical" href="{{ seo.baseUrl }}{{ page.url }}">

  <!-- Open Graph Tags -->
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ description or i18n[locale].seo.defaultDescription }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:url" content="{{ seo.baseUrl }}{{ page.url }}">
  <meta property="og:image" content="{{ ogImage or seo.defaultImage }}">
  {#
    Declaring the size lets a scraper lay the card out before it has finished
    downloading the image, and LinkedIn in particular is more reliable with it.
    The numbers are safe to hard-code because they are not a guess: every
    thumbnail is produced at 1200x630 by scripts/make-images.mjs, and
    check-build.sh asserts that geometry on the default AND on every post
    thumbnail. If one is ever generated at another size, the suite fails before
    these tags can start lying.
  #}
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ pageTitle }} — {{ seo.siteName }}">
  <meta property="og:locale" content="{{ locale or 'en' }}">
  <meta property="og:site_name" content="{{ seo.siteName }}">

  <!-- Twitter Card Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ description or i18n[locale].seo.defaultDescription }}">
  <meta name="twitter:image" content="{{ ogImage or seo.defaultImage }}">

  <!-- hreflang tags for SEO -->
  {% if i18nEnabled %}
  {% for lang in languages %}
    <link rel="alternate" hreflang="{{ lang }}" href="{{ seo.baseUrl }}{{ page.url | switchLanguage(lang) }}" />
  {% endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ seo.baseUrl }}{{ page.url | switchLanguage('en') }}" />
  {% endif %}

  <!-- Feed -->
  <link rel="alternate" type="application/atom+xml" title="{{ seo.siteName }}" href="/feed.xml">

  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png">

  <!-- Both webfonts and the maths stylesheet come from jsdelivr. -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>

  {#
    tty.bundle.css is the whole design system in ONE request, written by
    scripts/bundle-css.mjs from the @import list in src/styles/tty.css.

    Do not link /styles/tty.css here. That file is the authoring list of 14
    `@import`s: a browser cannot see those imports until it has fetched and parsed
    it, so the real stylesheet arrived on a second round trip — 80 KB over 15
    render-blocking requests. The sources stay split; only the delivery is joined.

    The KaTeX stylesheet used to sit on this line, on every page. Exactly one page in
    39 renders any maths, so 38 pages blocked first paint on a third-party request for
    nothing. It is injected by the `injectKatexStyles` transform now, into the pages
    that actually contain KaTeX markup — the same approach `injectPrismPlugins` takes
    for Prism.
  #}
  <link rel="stylesheet" href="/styles/tty.bundle.css">

  <!-- Structured Data -->
  {% include "structuredData.njk" %}
</head>
<body class="tty-shell">
    {% include "nav.njk" %}
    <main class="tty-main">
        {{ content | safe }}
    </main>
    {% include "footer.njk" %}
    {% include "searchOverlay.njk" %}
    {% if i18nEnabled %}{% include "languageRedirect.njk" %}{% endif %}

    <script defer src="/scripts/tty-search.js"></script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-2GHK298WZ2"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-2GHK298WZ2');
    </script>
</body>
</html>
